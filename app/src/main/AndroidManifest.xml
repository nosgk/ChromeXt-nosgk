<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- BEGIN GENERATED BROWSERS -->
    <queries>
        <package android:name="app.vanadium.browser" />
        <package android:name="com.android.browser" />
        <package android:name="com.android.chrome" />
        <package android:name="com.brave.browser" />
        <package android:name="com.brave.browser_beta" />
        <package android:name="com.brave.browser_nightly" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.canary" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.coccoc.trinhduyet" />
        <package android:name="com.coccoc.trinhduyet_beta" />
        <package android:name="com.herond.android.browser" />
        <package android:name="com.kiwibrowser.browser" />
        <package android:name="com.mi.globalbrowser" />
        <package android:name="com.naver.whale" />
        <package android:name="com.qihoo.contents" />
        <package android:name="com.vivaldi.browser" />
        <package android:name="com.vivaldi.browser.snapshot" />
        <package android:name="io.github.jqssun.helium" />
        <package android:name="org.axpos.aosmium" />
        <package android:name="org.bromite.bromite" />
        <package android:name="org.chromium.chrome" />
        <package android:name="org.chromium.thorium" />
        <package android:name="org.cromite.cromite" />
        <package android:name="org.greatfire.freebrowser" />
        <package android:name="org.triple.banana" />
        <package android:name="us.spotco.mulch" />
    </queries>
    <!-- END GENERATED BROWSERS -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The manager process checks script update URLs; under LSPosed it does not inherit the
         browser's network permission. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">
        <provider
            android:name=".provider.ScriptContentProvider"
            android:authorities="org.matrix.chromext.scripts"
            android:exported="true" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ChromeXt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.InstallScriptActivity"
            android:exported="true"
            android:label="@string/main_menu_install_script"
            android:theme="@style/Theme.ChromeXt">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/javascript" android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/javascript" android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/javascript" android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/javascript" android:scheme="http" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/javascript" android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.matrix.chromext.ACTION_INSTALL_SCRIPT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Module metadata, entry point and scope live in
             app/src/main/resources/META-INF/xposed/ (libxposed Modern API). -->
		<activity android:name=".OpenInChrome"
			android:label="@string/view_in_chrome"
			android:theme="@android:style/Theme.NoDisplay"
			android:exported="true">
			 <intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="text/javascript" android:scheme="content" />
			</intent-filter>
			 <intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="application/javascript" android:scheme="content" />
			</intent-filter>
			 <intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="text/html" android:scheme="content" />
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="text/plain" />
			</intent-filter>
		</activity>
    </application>

</manifest>
